# Shared config for ALL numbered lessons. Copy to .env, do not commit secrets.
# OpenAI: LLM_BASE_URL=https://api.openai.com/v1
# vLLM: LLM_BASE_URL=http://localhost:8000/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=30

# Optional for Lab 8 dense retrieval (model must support embeddings):
EMBEDDING_MODEL=
# Optional for Lab 9 if embeddings use a different endpoint/key:
# Leave empty to reuse LLM_BASE_URL and LLM_API_KEY.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# Lab 11: Qdrant Docker service (see 11-vector-search/compose.yaml).
# The default service binds to localhost only and has no API key.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
# If your development machine uses an HTTP proxy, bypass it for local Qdrant:
# NO_PROXY=localhost,127.0.0.1

# Lab 13 optional LLM-as-a-Judge. Leave empty to reuse the generation LLM.
# For independent evaluation, configure a DIFFERENT judge model if available.
EVAL_JUDGE_MODEL=
EVAL_JUDGE_BASE_URL=
EVAL_JUDGE_API_KEY=
